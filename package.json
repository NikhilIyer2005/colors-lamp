{
  "name": "colors-lamp",
  "version": "1.0.0",
  "description": "COLORS is a simple web application built using the LAMP stack. Users can log in, add colors associated with their account, and search for previously stored colors.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint:html": "htmlhint \"*.html\"",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:js": "eslint \"js/**/*.js\"",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikhilIyer2005/colors-lamp.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/NikhilIyer2005/colors-lamp/issues"
  },
  "homepage": "https://github.com/NikhilIyer2005/colors-lamp#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "htmlhint": "^1.9.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
