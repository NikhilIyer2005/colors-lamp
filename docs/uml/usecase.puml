@startuml
left to right direction

actor User

rectangle "COLORS Web Application" {
    usecase "Log In" as Login
    usecase "Add Color" as AddColor
    usecase "Search Colors" as SearchColors
    usecase "Log Out" as Logout
}

User --> Login
User --> AddColor
User --> SearchColors
User --> Logout

note right of AddColor
    Requires a successful Login
end note

note right of SearchColors
    Requires a successful login
end note

note right of Logout
    Clears the login cookie
    and returns to the login page
end note

@enduml